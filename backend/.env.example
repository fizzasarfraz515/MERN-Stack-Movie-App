# Port the API listens on (Render sets this automatically)
PORT=5000

# MongoDB Atlas connection string, e.g.
# mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/cineverse?retryWrites=true&w=majority
MONGO_URI=

# Long random string used to sign login tokens. Generate one with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# TMDB v3 API key (or the v4 "API Read Access Token") from themoviedb.org
TMDB_API_KEY=

# Allowed frontend origin(s), comma separated, no trailing slash
CLIENT_URL=http://localhost:5173
